# Public gateway/listener.
# The Go gateway intentionally uses the historical UVICORN_* names.
UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
# CREW_GATEWAY_ADDR = ":8000"
# CREW_PROXY_PROTOCOL = false
# CREW_PROXY_PROTOCOL_POLICY = "use" # "use" (accepts PROXY header or direct connections) or "require" (strict)
# CREW_PROXY_PROTOCOL_TRUSTED = "" # IPs or CIDRs allowed to send a PROXY header; empty means loopback and private ranges

# Gateway TLS.
# UVICORN_SSL_CERTFILE = "/var/lib/crew/certs/example.com/fullchain.pem"
# UVICORN_SSL_KEYFILE = "/var/lib/crew/certs/example.com/key.pem"
# UVICORN_SSL_CA_TYPE = "public"

# Database.
# SQLALCHEMY_DATABASE_URL = "sqlite:///db.sqlite3"

# Binary/install metadata.
# CREW_INSTALL_MODE = "binary"
# CREW_SCRIPT_BIN = "/usr/local/bin/crew"
# CREW_APP_DIR = "/opt/crew"
# CREW_DATA_DIR = "/var/lib/crew"
# CREW_SERVICE_NAME = "crew"

# Initial admin bootstrap.

# Node operations and user lifecycle jobs.
# CREW_NODE_OPERATIONS_POLL_INTERVAL = "15s"
# CREW_NODE_USAGE_COLLECTION_INTERVAL = "30s"
# CREW_NODE_USAGE_COLLECTION_LIMIT = 0
# CREW_USER_LIFECYCLE_INTERVAL = "10s"
# CREW_USER_LIFECYCLE_BATCH_SIZE = 500
# CREW_USER_USAGE_RESET_INTERVAL = "1h"
# CREW_USER_USAGE_RESET_BATCH_SIZE = 500
# CREW_USER_AUTODELETE_INTERVAL = "1h"
# CREW_USER_AUTODELETE_BATCH_SIZE = 500
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = false

# API behavior.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440
# USERS_LIST_TIMEOUT_SECONDS = 0

# Settings, templates, certificates, and backup roots.
# CREW_CERT_BASE = "/var/lib/crew/certs"
# CREW_CONFIG_DIR = "/etc/crew"

# Optional GitHub-hosted sponsor manifest and its persistent local cache.
# The manifest contains assets with: id, placement (header/header_mobile/sidebar/sidebar_logo), image_url,
# valid_until (RFC3339 or YYYY-MM-DD), and optional target_url, label, and alt.
# CREW_SPONSOR_MANIFEST_URL = "https://raw.githubusercontent.com/example/sponsors/main/manifest.json"
# CREW_SPONSOR_CACHE_DIR = "/var/lib/crew/sponsor-cache"
